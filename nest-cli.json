{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/cgv-open-notifier",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "apps/cgv-open-notifier/tsconfig.build.json"
  },
  "sourceRoot": "apps/cgv-open-notifier/src",
  "projects": {
    "cgv-open-notifier": {
      "type": "application",
      "root": "apps/cgv-open-notifier",
      "entryFile": "main",
      "sourceRoot": "apps/cgv-open-notifier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cgv-open-notifier/tsconfig.build.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "telegram": {
      "type": "library",
      "root": "libs/telegram",
      "entryFile": "index",
      "sourceRoot": "libs/telegram/src",
      "compilerOptions": {
        "tsConfigPath": "libs/telegram/tsconfig.lib.json"
      }
    },
    "megabox-open-notifier": {
      "type": "application",
      "root": "apps/megabox-open-notifier",
      "entryFile": "main",
      "sourceRoot": "apps/megabox-open-notifier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/megabox-open-notifier/tsconfig.build.json"
      }
    }
  }
}
